@{
    ViewData["BodyClass"] = "page page--privacy";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/pages/privacy.css" asp-append-version="true">
}

<main id="main-content">

    <div class="page-banner">
      <div class="container">
        <h1>Privacy Policy</h1>
      </div>
    </div>

    <section class="section section--tight" aria-labelledby="privacy-intro-title">
      <div class="container">
        <article class="legal-article">

          <p class="legal-modified-date">Last modified: 31 October 2024</p>
          
          <section class="legal-section">
            <h2 class="legal-section__title" id="privacy-intro-title">Hindawi Foundation Privacy Policy</h2>
                    <p class="legal-section__body">The Hindawi Foundation is a charity registered in England and Wales (Charity number: 1181788).</p>
                    <p class="legal-section__body"> The products and services provided by the Hindawi Foundation shall be referred to as our "Services" for the rest of this policy. Services include initiatives such as Booktime, Safahat, and Folios. Any mention of "Hindawi", "the Foundation", or "we" throughout this Policy is in reference to Hindawi Foundation as described above.</p>
          </section>

          <section class="legal-section">
            <h2 class="legal-section__title">What Does This Privacy Policy Cover?</h2>
            <p class="legal-section__body">This Privacy Policy explains how the Hindawi Foundation collects and uses personal information in relation to the products and services linked to this Policy. Our Services may be used by organisations such as schools and universities, as well as individuals such as students and families. We may collect personal data in order to provide our Services effectively.</p>
          </section>

          <section class="legal-section">
            <h2 class="legal-section__title">Contact</h2>
            <p class="legal-section__body">If you have any queries about our Privacy Policy, please contact us at: Hindawi Foundation, York House, 41 Sheet Street, Windsor, SL4 1DD. Email: <a href="mailto:hindawi@@hindawi.org">hindawi@@hindawi.org</a>.</p>
          </section>

        </article>
      </div>
    </section>

</main>
