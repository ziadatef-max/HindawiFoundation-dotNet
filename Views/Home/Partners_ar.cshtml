@{
    ViewData["BodyClass"] = "page page--partners";
    ViewData["ActivePage"] = "partners";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/pages/partners.css" asp-append-version="true">
}

<main id="main-content">

    <div class="page-banner">
      <div class="container">
        <h1>@localizer["partners_page_title"]</h1>
      </div>
    </div>

    <section class="section section--tight" aria-label="الشركاء">
      <div class="container">

        <div class="partners-intro">
          <h2 class="partners-intro__title">معًا نُمكِّن القراءة عالميًا</h2>
          <p>نشعر بامتنان عميق للمؤسسات الرؤيوية والشركاء المؤسَّسيين والجهات الراعية التي تحوِّل رسالتنا إلى واقع.</p>
          <p>فبتمويل تقنية الترجمة لدينا، وجهود النشر، والتوزيع العالمي، يُساعدنا شركاؤنا على تجاوز حواجز اللغة وإيصال الأدب المجاني إلى ملايين القُرَّاء حول العالم.</p>
          <p>إليكم نظرة على داعمينا والأثر الكبير الذي يحقِّقه تمويلهم.</p>
        </div>

        <div class="partner-cards-grid" role="list">

          <article class="partner-card" role="listitem">
            <div class="partner-card__logo">
              <img src="~/Logos/CNL.svg" alt="مجلس الكتاب الغيلي" class="partner-card__logo-img">
            </div>
            <div class="partner-card__content">
              <p class="partner-card__label">قاموا بتمويل</p>
              <p class="partner-card__value">بوك تايم</p>
              <p class="partner-card__label">الأثر</p>
              <p class="partner-card__value">ترجمة كتب إلى اللغة الغيلية</p>
            </div>
          </article>

          <article class="partner-card" role="listitem">
            <div class="partner-card__logo">
              <img src="~/Logos/Fundacao_Calouste_Gulbenkian.svg" alt="مؤسسة كالوست جولبنكيان" class="partner-card__logo-img">
            </div>
            <div class="partner-card__content">
              <p class="partner-card__label">قاموا بتمويل</p>
              <p class="partner-card__value">بوك تايم</p>
              <p class="partner-card__label">الأثر</p>
              <p class="partner-card__value">ترجمة كتب إلى اللغة الغيلية</p>
            </div>
          </article>

          <article class="partner-card" role="listitem">
            <div class="partner-card__logo">
              <img src="~/Logos/PRODOMINICANA.svg" alt="PRODOMINICANA" class="partner-card__logo-img">
            </div>
            <div class="partner-card__content">
              <p class="partner-card__label">قاموا بتمويل</p>
              <p class="partner-card__value">بوك تايم</p>
              <p class="partner-card__label">الأثر</p>
              <p class="partner-card__value">ترجمة كتب إلى اللغة الغيلية</p>
            </div>
          </article>

          <article class="partner-card" role="listitem">
            <div class="partner-card__logo">
              <img src="~/Logos/Birmingham_City_University.svg" alt="جامعة برمنغهام سيتي" class="partner-card__logo-img">
            </div>
            <div class="partner-card__content">
              <p class="partner-card__label">قاموا بتمويل</p>
              <p class="partner-card__value">بوك تايم</p>
              <p class="partner-card__label">الأثر</p>
              <p class="partner-card__value">ترجمة كتب إلى اللغة الغيلية</p>
            </div>
          </article>

        </div>
      </div>
    </section>

    <section class="section section--tight partners-cta" aria-labelledby="partners-cta-title">
      <div class="container">
        <h2 class="partners-cta__title" id="partners-cta-title">شاركنا في نشر متعة القراءة</h2>
        <p class="partners-cta__text">هل تمثل منظَّمة أو صندوقًا أو مؤسسةً مُهتمَّة بالتعليم العالمي، أو الحفاظ على الثقافة، أو إتاحة التقنية للجميع؟ نبحث دائمًا عن شركاء رؤيويين لمساعدتنا في الوصول إلى مجتمعات جديدة ونشر مزيد من الكتب.</p>
        <p class="partners-cta__text">سواء أردتَ تمويل مبادرة لغوية بعينها، أو رعاية مشروع محدَّد، أو دعم عملياتنا الأساسية، فنحن متحمِّسون للتعاون.</p>
        <a href="#" class="btn btn--primary btn--icon partners-cta__btn">
          <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          @localizer["partners_email_team_button"]
        </a>
      </div>
    </section>

</main>
