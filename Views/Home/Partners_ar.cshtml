@using Microsoft.Extensions.Options
@inject IOptions<HindawiFoundation.Web.Models.AppSettings> Options
@{

    ViewData["BodyClass"] = "page page--partners";
    ViewData["ActivePage"] = "partners";

    var partnershipsTeamEmail = Options.Value.PartnershipsTeamEmail;
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/pages/partners.css" asp-append-version="true">
}

<main id="main-content">

    <div class="page-banner">
      <div class="container">
            <h1>شركاؤنا</h1>
      </div>
    </div>

    <section class="section section--tight" aria-label="الشركاء">
      <div class="container">

        <div class="partners-intro">
          <h2 class="partners-intro__title">معًا ننشر حب القراءة حول العالم</h2>
          <p>نُعرب عن بالغ امتناننا للمؤسَّسات والجهات الراعية الرائدة التي شاركتنا رؤيتَنا وساهمت في تحويل رسالتنا إلى واقع ملموس.</p>
          <p>بفضل دعمهم تقنياتِ الترجمة وجهودَ النشر والتوزيع، يُسهِم شركاؤنا في تخطي الحواجز اللغوية، فاتحين بذلك أبواب المعرفة والأدب مجانًا أمام ملايين القراء حول العالم.</p>
          <p>تعرفوا على شركائنا الداعمين والأثر الملموس الذي حقَّقه تمويلهم في دعم رسالتنا:</p>
        </div>

        <div class="partner-cards-grid" role="list">

          <article class="partner-card" role="listitem">
            <div class="partner-card__logo">
              <img src="~/Logos/CNL.png?v=4" alt="مجلس الكتاب الغيلي" class="partner-card__logo-img">
            </div>
            <div class="partner-card__content">              
              <p class="partner-card__value_title">بوك تايم</p>
              <p class="partner-card__label">الأثر المرجو</p>
              <p class="partner-card__value">ترجمة كتب إلى اللغة الغيلية</p>
            </div>
          </article>

          <article class="partner-card" role="listitem">
            <div class="partner-card__logo">
              <img src="~/Logos/Fundacao_Calouste_Gulbenkian.png?v=4" alt="مؤسسة كالوست جولبنكيان" class="partner-card__logo-img">
            </div>
            <div class="partner-card__content">            
              <p class="partner-card__value_title">بوك تايم</p>
              <p class="partner-card__label">الأثر المرجو</p>
              <p class="partner-card__value">ترجمة الكتب إلى اللغة الأرمنية الغربية</p>
            </div>
          </article>

          <article class="partner-card" role="listitem">
            <div class="partner-card__logo">
              <img src="~/Logos/PRODOMINICANA.png?v=4" alt="PRODOMINICANA" class="partner-card__logo-img">
            </div>
            <div class="partner-card__content">
              <p class="partner-card__value_title">صفحات</p>
              <p class="partner-card__label">الأثر المرجو</p>
              <p class="partner-card__value">دعم إنتاج الكتب الصوتية</p>
            </div>
          </article>

          <article class="partner-card" role="listitem">
            <div class="partner-card__logo">
              <img src="~/Logos/Birmingham_City_University.png?v=4" alt="جامعة برمنغهام سيتي" class="partner-card__logo-img">
            </div>
            <div class="partner-card__content">             
              <p class="partner-card__value_title">بوك تايم</p>
              <p class="partner-card__label">الأثر المرجو</p>
              <p class="partner-card__value">دعم المواهب الشابة من الرسامين</p>
            </div>
          </article>

          <article class="partner-card" role="listitem">
            <div class="partner-card__logo">
                <img src="~/Logos/Ulverscroft.png?v=4" alt="Ulverscroft" class="partner-card__logo-img">
            </div>
            <div class="partner-card__content">             
              <p class="partner-card__value_title">بوك تايم</p>
              <p class="partner-card__label">الأثر المرجو</p>
              <p class="partner-card__value">دعم إنتاج الكتب الصوتية</p>
            </div>
          </article>
          

        </div>
      </div>
    </section>

    <section class="section section--tight partners-cta" aria-labelledby="partners-cta-title">
      <div class="container">
        <h2 class="partners-cta__title" id="partners-cta-title">شاركونا لننشر متعة القراءة معًا</h2>
        <p class="partners-cta__text">إذا كنت تمثِّل منظمة أو صندوقَ تمويل أو جهة مانحة تهتم بالنهوض بالتعليم على مستوى العالم، أو بالحفاظ على التراث الثقافي، أو بإتاحة الحلول التكنولوجية للجميع، فإننا نرحب بالتعاون معك. نحن نسعى دائمًا إلى بناء شراكات استراتيجية مع أصحاب الرؤى الطموحة لمساعدتنا على الوصول إلى مجتمعات جديدة ونشر المعرفة عبر مزيد من الكتب.</p>
        <p class="partners-cta__text">يسرُّنا التعاون معك؛ سواء من خلال تمويل مبادرة لغوية محددة، أو رعاية مشروع بعينه، أو دعم عملياتنا التشغيلية.</p>
            <a href="mailto:@partnershipsTeamEmail" class="btn btn--primary btn--icon partners-cta__btn">
          <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          @localizer["email_our_partnerships_team_button"]
        </a>
      </div>
    </section>

</main>
