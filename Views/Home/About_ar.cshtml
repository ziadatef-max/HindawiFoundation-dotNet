@{
    ViewData["BodyClass"] = "page page--about";
    ViewData["ActivePage"] = "about";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/pages/about.css" asp-append-version="true">
}

<main id="main-content">

    <div class="page-banner">
      <div class="container">
            <h1>مَن نحن</h1>
      </div>
    </div>

    <section class="section section--tight about-content" aria-label="عن مؤسسة هنداوي">
      <div class="container">
        <p>على مدار ما يقرب من عشرين عامًا، نجحت «مؤسسة هنداوي» في نشر حب القراءة وإتاحة المعرفة لملايين القرَّاء حول العالم.</p>
        <p>ومنذ انطلاقتنا الأولى، كرَّسنا جهودنا لسد النقص الحاد في المحتوى المتنوع والثري المتاح للقراءة باللغة العربية. ولمواجهة هذا التحدي، حصلنا على حقوق ترجمة ونشر مجموعة واسعة من الكتب، إلى جانب إعادة نشر أعمال رائدة في الأدب العربي، منها أعمال الأديب الحاصل على جائزة نوبل، «نجيب محفوظ»، وأتحناها للقراءة والتحميل مجانًا بالكامل. ولا تزال هذه الكتب متاحة للجميع عبر موقعنا: <a href="https://www.hindawi.org/" target="_blank" rel="noopener noreferrer">Safahat.org</a>.</p>
        <p>وانطلاقًا من إيماننا الراسخ بأن «القراءة تصنع الفارق»، عزَّزنا آفاق رسالتنا في عام 2024 لتشمل نشر حب القراءة وإتاحتها عالميًّا بكافة اللغات.</p>
        <p>وسعيًا منا لتحويل هذه الرؤية إلى واقع ملموس، أطلقنا مبادرة «بوك تايم» الخيرية المتخصصة في كتب الأطفال المصورة بلغات متعددة، منها العربية والإنجليزية والبرتغالية والإسبانية واليابانية. وقد خصصنا لهذه المبادرة تطبيقًا وموقعًا إلكترونيًّا لكسر الحواجز المادية والجغرافية التقليدية. فعندما نتيح للأطفال من مختلف الخلفيات اطلاعًا مجانيًّا على كتب تنطق بلغتهم وتعكس ثقافتهم، فإننا نغرس فيهم حب المعرفة منذ الصغر، ونبني جسورًا للتواصل بين الثقافات على مستوى العالم.</p>
        <p>في عام 2026، عززنا التزامنا بإتاحة المعرفة عالميًّا من خلال إطلاق «فوليوس»، الذي يوظف تقنيات الذكاء الاصطناعي لتمكين المستخدمين من ترجمة الكتب بأنفسهم. وبكسر تلك الحواجز اللغوية، يضمن «فوليوس» ألا تقف اللغة عائقًا أمام شغفك، بحيث يتيح لك قراءة ما ترغب من الكتب باللغة التي تختارها.</p>
        <p>«مؤسسة هنداوي» هي مؤسسة خيرية مسجلة في إنجلترا وويلز تحت رقم 1181788، ولها مقران رئيسيان في وندسور بالمملكة المتحدة، والآخر في القاهرة ﺑِجمهورية مصر العربية.</p>
      </div>
    </section>

    <section class="section impact" aria-labelledby="impact-title">
      <div class="container">
            <h2 class="section__title" id="impact-title">تأثيرنا</h2>
        <div class="impact-grid" role="list">
          <article class="impact-item" role="listitem">
            <div class="impact-icon">
              <i class="fa-solid fa-users" aria-hidden="true"></i>
            </div>
            <p class="number">+300 ألف</p>
            <p class="label">قارئ شهريًّا</p>
          </article>

          <article class="impact-item" role="listitem">
            <div class="impact-icon">
              <img src="~/Icons/book-open-cover.svg?v=4" alt="">
            </div>
            <p class="number">10 مليون</p>
            <p class="label">كتاب تمت قراءته منذ عام 2024</p>
          </article>

          <article class="impact-item" role="listitem">
            <div class="impact-icon">
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            </div>
            <p class="number">+190 </p>
            <p class="label">دولة تستفيد من خدماتنا</p>
          </article>

          <article class="impact-item" role="listitem">
            <div class="impact-icon">
              <i class="fa-solid fa-globe" aria-hidden="true"></i>
            </div>
            <p class="number">+9</p>
            <p class="label"> لغات متاحة</p>
          </article>

          <article class="impact-item" role="listitem">
            <div class="impact-icon">
              <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i>
            </div>
            <p class="number">3500+</p>
                    <p class="label">كتاب منشور (ويشمل ذلك الكتب المترجمة)</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--tight founders" aria-labelledby="founders-title">
      <div class="container">
        <h2 class="founders__title" id="founders-title">المؤسسان</h2>
        <p class="founders__intro">تكرِّس الدكتورة نجوى عبد المطلب والدكتور أحمد هنداوي جهودهما لنشر متعة القراءة، وتيسير سبل الوصول إلى المعرفة للجميع حول العالم.</p>

        <div class="founders__grid">
          <article class="founder">
            <img class="founder__photo" src="~/Images/Ahmed_Hindawi.svg?v=4" alt="أحمد هنداوي، الرئيس التنفيذي">
            <h3 class="founder__name">أحمد هنداوي</h3>
            <p class="founder__role">الرئيس التنفيذي</p>
          </article>

          <article class="founder">
            <img class="founder__photo" src="~/Images/Nagwa_Abdelmottaleb.svg?v=4" alt="نجوى عبد المطلب، نائب الرئيس التنفيذي">
            <h3 class="founder__name">نجوى عبد المطلب</h3>
            <p class="founder__role">نائب الرئيس التنفيذي</p>
          </article>
        </div>
      </div>
    </section>

</main>
