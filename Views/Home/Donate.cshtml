@model HindawiFoundation.Web.Models.DonationViewModel
@using Microsoft.Extensions.Options
@inject IOptions<HindawiFoundation.Web.Models.AppSettings> Options
    @{
    ViewData["BodyClass"] = "page page--donate";
    ViewData["ActivePage"] = "donate";
    ViewData["TitleKey"] = "donate_button";
    var routeCulture = ViewContext.RouteData.Values["culture"]?.ToString()?.ToLowerInvariant();
    var culture = routeCulture == "ar" ? "ar" : "en";
    var recaptchaSiteKey = Options.Value.DonationApi.GoogleRecaptchaKey;
    var cfCountryCode = Context.Request.Headers["cf-ipcountry"].FirstOrDefault() ?? "US";
    }

    @section Styles {
        <link rel="stylesheet" href="~/assets/css/pages/donate.css" asp-append-version="true">
        <script src="https://www.google.com/recaptcha/api.js?hl=@culture" async defer></script>
    }

    <main id="main-content">

        <div class="page-banner">
            <div class="container">
                <h1>@localizer["donate_button"]</h1>
            </div>
        </div>

        <section class="section section--tight" aria-labelledby="donate-intro-title">
            <div class="container">

                <div class="donate-intro">
                    <h2 class="donate-intro__title" id="donate-intro-title">@localizer["help_us_spread_the_joy_of_reading_title_label"]</h2>
                    <p class="donate-intro__desc">@localizer["donation_intro_content_label"]</p>
                </div>

                <div class="donate-form-wrap">
                    <div class="donate-form-card">

                        <div class="payment-methods" role="group" aria-label="Payment method">
                            <button class="payment-method is-active" type="button" data-payment="card" aria-pressed="true">
                                <span class="payment-method__icon payment-method__icon--card" aria-hidden="true"></span>
                                @localizer["credit/debit_card_button"]
                            </button>

                            <button class="payment-method" type="button" data-payment="wire" aria-pressed="false">
                                <span class="payment-method__icon payment-method__icon--wire" aria-hidden="true"></span>
                                @localizer["wire_transfer_button"]
                            </button>

                            @* PayPal tab: code kept but hidden until PayPal is re-enabled *@
                        <button class="payment-method" type="button" data-payment="paypal" aria-pressed="false" style="display:none" aria-hidden="true">
                                <span class="payment-method__icon payment-method__icon--paypal" aria-hidden="true"></span>
                                @localizer["paypal_button"]
                            </button>
                        </div>

                        <div class="donate-form-body">

                            <div class="payment-panel is-active" data-payment-panel="card">
                                <form id="donateForm"
                                      action="@Url.Action("Index", "Donate", new { culture = culture })"
                                      method="post"
                                      novalidate>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="PaymentMethodnonce" id="PaymentMethodnonce" />

                                    <div class="donate-grid donate-grid--3">

                                        <div class="form-field">
                                            <label class="donation-form-field__label">@localizer["donation_frequency_label"]</label>
                                            <div class="frequency-options">
                                                <label class="frequency-option">
                                                    <input type="radio" asp-for="Frequency" value="one-time"> @localizer["donation_frequency_one_time_button"]
                                                </label>
                                                <label class="frequency-option">
                                                    <input type="radio" asp-for="Frequency" value="monthly"> @localizer["donation_frequency_monthly_button"]
                                                </label>
                                            </div>
                                        </div>

                                        <div class="form-field">
                                            <label class="form-field__label" for="donationAmount">@localizer["donation_amount_label"]</label>
                                            <div class="amount-input-wrap">
                                                <input class="form-input" type="number" asp-for="Amount" id="donationAmount" min="1" step="1" autocomplete="off">
                                                <div class="currency-select" data-currency-select>
                                                    <input type="hidden" asp-for="CurrencyCode" id="CurrencyCode" data-currency-value />
                                                    <button type="button"
                                                            class="currency-select__trigger"
                                                            aria-haspopup="listbox"
                                                            aria-expanded="false"
                                                            data-currency-trigger>
                                                        <span class="currency-select__selected" data-currency-selected>USD</span>
                                                        <span class="currency-select__arrow" aria-hidden="true"></span>
                                                    </button>
                                                    <div class="currency-select__dropdown" data-currency-dropdown hidden>
                                                        <ul class="currency-select__list" role="listbox" data-currency-list>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                            <span class="field-error" id="amount_span"></span>
                                        </div>

                                        <div class="form-field">
                                            <label class="form-field__label" for="donorEmail">@localizer["donation_email_label"]</label>
                                            <input class="form-input" type="email" asp-for="Email" id="donorEmail" autocomplete="email">
                                            <span class="field-error" id="email_span"></span>
                                        </div>

                                    </div>

                                    <div class="donate-grid donate-grid--3">

                                        <div class="form-field">
                                            <label class="form-field__label" for="firstName">@localizer["donation_first_name_label"]</label>
                                            <input class="form-input" type="text" asp-for="FirstName" id="firstName" autocomplete="given-name">
                                        </div>

                                        <div class="form-field">
                                            <label class="form-field__label" for="lastName">@localizer["donation_last_name_label"]</label>
                                            <input class="form-input" type="text" asp-for="LastName" id="lastName" autocomplete="family-name">
                                        </div>

                                        <div class="form-field">
                                            <label class="form-field__label" for="phone">@localizer["donation_phone_label"]</label>
                                            <input class="form-input" type="tel" asp-for="Phone" id="phone" autocomplete="tel">
                                            <span class="field-error" id="phone_span"></span>
                                        </div>

                                    </div>

                                    <hr class="donate-divider">

                                    <div class="donate-grid donate-grid--card">

                                        <div class="form-field form-field--card-number">
                                            <label class="form-field__label" for="cardNumber">@localizer["donation_card_number_label"]</label>
                                            <div class="card-number-input">
                                                <div class="form-input card-number-input__field" id="cardNumber"></div>
                                                <div class="card-number-input__icons" aria-hidden="true">
                                                    <img src="~/Icons/master-card.svg?v=4" alt="">
                                                    <img src="~/Icons/visa.svg?v=4" alt="">
                                                </div>
                                            </div>
                                            <span class="field-error" id="s_number"></span>
                                        </div>

                                        <div class="form-field">
                                            <label class="form-field__label" for="cardExpiry">@localizer["donation_expiry_label"]</label>
                                            <div class="form-input" id="cardExpiry"></div>
                                            <span class="field-error" id="s_expirationDate"></span>
                                        </div>

                                        <div class="form-field">
                                            <label class="form-field__label" for="cardCvc">@localizer["donation_cvv_label"]</label>
                                            <div class="cvv-input">
                                                <div class="form-input cvv-input__field" id="cardCvc"></div>
                                                <img src="~/Icons/cvv.svg?v=4"
                                                     alt="@localizer["donation_cvv_icon_alt_label"]"
                                                     class="cvv-icon"
                                                     aria-hidden="true">
                                            </div>
                                            <span class="field-error" id="s_cvv"></span>
                                        </div>

                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(recaptchaSiteKey))
                                    {
                                        <div class="form-field form-field--recaptcha">
                                            <div class="recaptcha-wrap">
                                                <div class="g-recaptcha" data-sitekey="@recaptchaSiteKey" data-callback="hindawiRecaptchaCallback"></div>
                                            </div>
                                            <span class="field-error@(Model?.ShowRecaptchaError == true ? " is-visible" : "")" id="robot_span">@(Model?.ShowRecaptchaError == true ? localizer["recaptcha_error"].Value : "")</span>
                                        </div>
                                    }

                                    <div class="form-input-validation-container" id="donateMessageContainer" role="alert" aria-live="polite"@(Model?.ShowDonationError == true ? "" : " hidden")>
                                        <p class="validation-form-message alert validation-message@(Model?.ShowDonationError == true ? " shown" : "")" id="donateMessage">@(Model?.ShowDonationError == true ? localizer["donation_failure_message"].Value : "")</p>
                                    </div>

                                    <button class="donate-submit" type="submit" id="donateSubmitBtn">
                                        <i class="fa-solid fa-heart" aria-hidden="true"></i>
                                        @localizer["donation_submission_button"]
                                    </button>

                                </form>
                            </div>

                            <div class="payment-panel" data-payment-panel="wire" hidden>
                                <div class="wire-transfer-table" aria-label="Bank transfer details">
                                    <div class="wire-transfer-row">
                                        <span class="wire-transfer-row__label">@localizer["wire_transfer_account_name_label"]</span>
                                        <span class="wire-transfer-row__value">@localizer["wire_transfer_account_name_value_label"]</span>
                                    </div>
                                    <div class="wire-transfer-row">
                                        <span class="wire-transfer-row__label">@localizer["wire_transfer_bank_code_label"]</span>
                                        <span class="wire-transfer-row__value">@localizer["wire_transfer_bank_code_value_label"]</span>
                                    </div>
                                    <div class="wire-transfer-row">
                                        <span class="wire-transfer-row__label">@localizer["wire_transfer_account_number_label"]</span>
                                        <span class="wire-transfer-row__value">@localizer["wire_transfer_account_number_value_label"]</span>
                                    </div>
                                    <div class="wire-transfer-row">
                                        <span class="wire-transfer-row__label">@localizer["wire_transfer_swift_code_label"]</span>
                                        <span class="wire-transfer-row__value">@localizer["wire_transfer_swift_code_value_label"]</span>
                                    </div>
                                    <div class="wire-transfer-row">
                                        <span class="wire-transfer-row__label">@localizer["wire_transfer_iban_label"]</span>
                                        <span class="wire-transfer-row__value">@localizer["wire_transfer_iban_value_label"]</span>
                                    </div>
                                    <div class="wire-transfer-row wire-transfer-row--last">
                                        <span class="wire-transfer-row__label">@localizer["wire_transfer_bank_location_label"]</span>
                                        <span class="wire-transfer-row__value">@localizer["wire_transfer_bank_location_value_label"]</span>
                                    </div>
                                </div>
                            </div>

                            @* PayPal panel: code kept, hidden at tab level *@
                            <div class="payment-panel" data-payment-panel="paypal" hidden>

                                <div class="donate-grid donate-grid--3">

                                    <div class="form-field">
                                        <label class="donation-form-field__label">@localizer["donation_frequency_label"]</label>
                                        <div class="frequency-options">
                                            <label class="frequency-option">
                                                <input type="radio" name="frequency-pp" value="one-time"> @localizer["donation_frequency_one_time_button"]
                                            </label>
                                            <label class="frequency-option">
                                                <input type="radio" name="frequency-pp" value="monthly" checked> @localizer["donation_frequency_monthly_button"]
                                            </label>
                                        </div>
                                    </div>

                                    <div class="form-field">
                                        <label class="form-field__label" for="ppAmount">@localizer["donation_amount_label"]</label>
                                        <div class="amount-input-wrap">
                                            <input class="form-input" type="number" id="ppAmount" name="ppAmount" min="1" step="1" autocomplete="off">
                                            <span class="amount-currency">EGP</span>
                                        </div>
                                    </div>

                                    <div class="form-field">
                                        <label class="form-field__label" for="ppEmail">@localizer["donation_email_label"]</label>
                                        <input class="form-input" type="email" id="ppEmail" name="ppEmail" autocomplete="email">
                                    </div>

                                </div>

                                <div class="donate-grid donate-grid--3">

                                    <div class="form-field">
                                        <label class="form-field__label" for="ppFirst">@localizer["donation_first_name_label"]</label>
                                        <input class="form-input" type="text" id="ppFirst" name="ppFirst" autocomplete="given-name">
                                    </div>

                                    <div class="form-field">
                                        <label class="form-field__label" for="ppLast">@localizer["donation_last_name_label"]</label>
                                        <input class="form-input" type="text" id="ppLast" name="ppLast" autocomplete="family-name">
                                    </div>

                                    <div class="form-field">
                                        <label class="form-field__label" for="ppPhone">@localizer["donation_phone_label"]</label>
                                        <input class="form-input" type="tel" id="ppPhone" name="ppPhone" autocomplete="tel">
                                    </div>

                                </div>

                                <hr class="donate-divider">

                                <div class="paypal-panel">
                                    <p class="paypal-message">Continue to PayPal to complete your donation.</p>
                                    <button class="paypal-button" type="button" aria-label="Pay with PayPal">
                                        <img src="~/Icons/paypal.svg?v=4" alt="" class="paypal-button__icon">
                                    </button>
                                </div>

                            </div>

                        </div>

                    </div>
                </div>

            <p class="donate-note">                
                @localizer["donation_contact_label"].Value.Replace("{donation_email}",Options.Value.DonationApi.DonationEmail)              
            </p>

            </div>
        </section>

        <section class="section impact" aria-labelledby="impact-donate-title">
            <div class="container">
                <h2 class="section__title" id="impact-donate-title">@localizer["impact_label"]</h2>
                <div class="impact-grid" role="list">
                    <article class="impact-item" role="listitem">
                        <div class="impact-icon"><i class="fa-solid fa-users" aria-hidden="true"></i></div>
                        <p class="number">@localizer["impact_first_subhead_label"]</p>
                        <p class="label">@localizer["impact_first_content_label"]</p>
                    </article>
                    <article class="impact-item" role="listitem">
                        <div class="impact-icon"><img src="~/Icons/book-open-cover.svg?v=4" alt=""></div>
                        <p class="number">@localizer["impact_second_subhead_label"]</p>
                        <p class="label label--nowrap">@localizer["impact_second_content_label"]</p>
                    </article>
                    <article class="impact-item" role="listitem">
                        <div class="impact-icon"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></div>
                        <p class="number">@localizer["impact_third_subhead_label"]</p>
                        <p class="label">@localizer["impact_third_content_label"]</p>
                    </article>
                    <article class="impact-item" role="listitem">
                        <div class="impact-icon"><i class="fa-solid fa-globe" aria-hidden="true"></i></div>
                        <p class="number">@localizer["impact_fourth_subhead_label"]</p>
                        <p class="label">@localizer["impact_fourth_content_label"]</p>
                    </article>
                    <article class="impact-item" role="listitem">
                        <div class="impact-icon"><i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i></div>
                        <p class="number">@localizer["impact_fifth_subhead_label"]</p>
                        <p class="label">@localizer["impact_fifth_content_label"]</p>
                    <span class="label label-note">@localizer["impact_fifth_content_note_label"]</span>
                    </article>
                </div>
            </div>
        </section>

        <section class="section section--tight testimonials" aria-labelledby="testimonials-donate-title">
            <div class="container">
                <header class="section__header">
                    <h2 class="section__title" id="testimonials-donate-title">@localizer["testimonials_label"]</h2>
                </header>

            <div class="testimonial-slider" data-slider tabindex="0" aria-label="Testimonials slider">
                    <div class="testimonial-track" data-slider-track>
                        <article class="card card--testimonial" data-slide>
                            <p class="quote">@localizer["testimonials_first_quote_label"]</p>
                            <div class="author-row">
                                <p class="author">@localizer["testimonials_first_user_label"]</p>
                                <img src="~/Icons/quote_mark.svg?v=4" alt="" class="quote-mark" aria-hidden="true">
                            </div>
                        </article>
                        <article class="card card--testimonial" data-slide>
                            <p class="quote">@localizer["testimonials_second_quote_label"]</p>
                            <div class="author-row">
                                <p class="author">@localizer["testimonials_second_user_label"]</p>
                                <img src="~/Icons/quote_mark.svg?v=4" alt="" class="quote-mark" aria-hidden="true">
                            </div>
                        </article>
                    </div>
                @* <div class="slider-dots" aria-label="Slider pagination">
                    <button class="slider-dot is-active" type="button" data-slide-to="0" aria-label="Show testimonial 1" aria-current="true"></button>
                    <button class="slider-dot" type="button" data-slide-to="1" aria-label="Show testimonial 2" aria-current="false"></button>
                    </div>
                </div> *@
            </div>
        </section>

    </main>

    @section Scripts {
        <script src="https://js.braintreegateway.com/web/3.96.0/js/client.min.js"></script>
        <script src="https://js.braintreegateway.com/web/3.96.0/js/hosted-fields.min.js"></script>
        <script>
  (function () {
    'use strict';

    var donationCulture = '@culture';
    var cfCountryCode   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cfCountryCode));
    var clientToken = @Html.Raw(string.IsNullOrWhiteSpace(Model?.ClientToken) ? "null" : "\"" + Model.ClientToken + "\"");
    var form        = document.getElementById('donateForm');
    var submitBtn   = document.getElementById('donateSubmitBtn');
    var msgContainer = document.getElementById('donateMessageContainer');
    var msg         = document.getElementById('donateMessage');
    var nonceField  = document.getElementById('PaymentMethodnonce');
    var currencyField = document.getElementById('CurrencyCode');
    var amountInput = document.getElementById('donationAmount');
    var phoneInput  = document.getElementById('phone');
    var hostedFieldsInstance = null;
    var isSubmitting = false;
    var hasServerDonationError = @(Model?.ShowDonationError == true ? "true" : "false");

    var currencyMinAmount   = 1;
    var currenciesData      = [];
    var currencySelectEl    = document.querySelector('[data-currency-select]');
    var currencyTriggerEl   = currencySelectEl ? currencySelectEl.querySelector('[data-currency-trigger]') : null;
    var currencyCodeLabelEl = currencySelectEl ? currencySelectEl.querySelector('[data-currency-selected]') : null;
    var currencyDropdownEl  = currencySelectEl ? currencySelectEl.querySelector('[data-currency-dropdown]') : null;
    var currencyListEl      = currencySelectEl ? currencySelectEl.querySelector('[data-currency-list]') : null;

    var hfContainerMap = {
      'number'        : document.getElementById('cardNumber'),
      'expirationDate': document.getElementById('cardExpiry'),
      'cvv'           : document.getElementById('cardCvc')
    };

    var validationMsgs = {
        amountRequired    : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["empty_donation_amount_message"].Value)),
        amountMin         : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["donation_minimum_amount_message"].Value)),
        emailRequired     : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["empty_email_message"].Value)),
        emailInvalid      : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["invalid_email_message"].Value)),
        cardRequired      : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["invalid_card_number_message"].Value)),
        expiryRequired    : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["invalid_expiry_date_message"].Value)),
        cvvRequired       : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["invalid_cvv_message"].Value)),
        cardNumberRequired : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["empty_card_number_message"].Value)),
        expiryFieldRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["empty_expiry_date_message"].Value)),
        cvvFieldRequired   : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["empty_cvv_message"].Value)),
        phoneInvalid       : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["invalid_phone_message"].Value)),
        recaptchaRequired  : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["recaptcha_error"].Value))
    };

    var cardNumberPlaceholder = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["donation_card_number_placeholder_label"].Value));
    var cvvPlaceholder        = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["donation_cvv_placeholder_label"].Value));

    function showFieldError(spanId, message) {
      var span = document.getElementById(spanId);
      if (!span) return;
      span.textContent = message || '';
      span.classList.toggle('is-visible', !!message);
    }

    function clearFieldError(spanId) {
      showFieldError(spanId, '');
    }

    function setInputState(el, invalid) {
      if (!el) return;
      el.classList.toggle('is-invalid', invalid);
    }

        function clearGlobalError() {
        if (msg) {
        msg.textContent = '';
        msg.classList.remove('shown');
        }

        if (msgContainer) {
        msgContainer.hidden = true;
        msgContainer.classList.remove('is-visible');
        }
    }


            function showMessage(text, isError) {
          if (!msg || !msgContainer) return;

          if (isError && text) {
            msg.textContent = text;
            msg.classList.add('shown');

            msgContainer.hidden = false;
            msgContainer.classList.add('is-visible');
          } else {
            clearGlobalError();
          }
        }

    function setSubmitting(state) {
      isSubmitting = state;
      if (submitBtn) {
        submitBtn.disabled = state;
        submitBtn.classList.toggle('is-loading', state);
      }
    }

    var CURRENCY_USD = { currencyCode: 'USD', currencyName: 'United States Dollar', exchangeRate: 1 };

    function escHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function selectCurrency(code) {
      if (!currenciesData.length) return;
      var found = null, i;
      for (i = 0; i < currenciesData.length; i++) {
        if (currenciesData[i].currencyCode === code) { found = currenciesData[i]; break; }
      }
      if (!found) {
        for (i = 0; i < currenciesData.length; i++) {
          if (currenciesData[i].currencyCode === 'USD') { found = currenciesData[i]; break; }
        }
      }
      if (!found) found = currenciesData[0] || CURRENCY_USD;

      if (currencyField)    currencyField.value       = found.currencyCode;
      if (currencyCodeLabelEl) currencyCodeLabelEl.textContent = found.currencyCode;

      if (currencyListEl) {
        currencyListEl.querySelectorAll('[data-value]').forEach(function (item) {
          var sel = item.getAttribute('data-value') === found.currencyCode;
          item.classList.toggle('is-selected', sel);
          item.setAttribute('aria-selected', sel ? 'true' : 'false');
        });
      }

      var rate = parseFloat(found.exchangeRate);
      currencyMinAmount = (rate && rate > 0) ? rate : 1;
    }

    function openCurrencyDropdown() {
      if (!currencyDropdownEl || !currencyTriggerEl) return;
      currencyDropdownEl.hidden = false;
      currencyTriggerEl.setAttribute('aria-expanded', 'true');
      var sel = currencyDropdownEl.querySelector('.is-selected');
      if (sel) sel.scrollIntoView({ block: 'nearest' });
    }

    function closeCurrencyDropdown() {
      if (!currencyDropdownEl || !currencyTriggerEl) return;
      currencyDropdownEl.hidden = true;
      currencyTriggerEl.setAttribute('aria-expanded', 'false');
    }

    function buildCurrencyOption(c) {
      var li = document.createElement('li');
      li.className = 'currency-select__option';
      li.setAttribute('role', 'option');
      li.setAttribute('tabindex', '0');
      li.setAttribute('data-value', c.currencyCode);
      li.setAttribute('aria-selected', 'false');
      var codeHtml = '<span class="currency-select__code" dir="ltr">' + escHtml(c.currencyCode) + '</span>';
      var sepHtml  = '<span class="currency-select__separator">|</span>';
      var nameHtml = '<span class="currency-select__name">' + escHtml(c.currencyName) + '</span>';
      li.innerHTML = donationCulture === 'ar'
        ? nameHtml + sepHtml + codeHtml
        : codeHtml + sepHtml + nameHtml;
      li.addEventListener('click', function () { selectCurrency(c.currencyCode); closeCurrencyDropdown(); });
      li.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectCurrency(c.currencyCode); closeCurrencyDropdown(); }
        if (e.key === 'Escape') closeCurrencyDropdown();
      });
      return li;
    }

    function populateCurrencies(currencies, defaultCode) {
      currenciesData = (Array.isArray(currencies) && currencies.length) ? currencies : [CURRENCY_USD];
      var hasUsd = currenciesData.some(function (c) { return c.currencyCode === 'USD'; });
      if (!hasUsd) currenciesData = currenciesData.concat([CURRENCY_USD]);
      if (!currencyListEl) { selectCurrency(defaultCode || 'USD'); return; }
      currencyListEl.innerHTML = '';
      currenciesData.forEach(function (c) { currencyListEl.appendChild(buildCurrencyOption(c)); });
      var codeInList = currenciesData.some(function (c) { return c.currencyCode === defaultCode; });
      selectCurrency(codeInList ? defaultCode : 'USD');
    }

    if (currencyTriggerEl) {
      currencyTriggerEl.addEventListener('click', function (e) { e.stopPropagation(); openCurrencyDropdown(); });
    }
    document.addEventListener('click', function (e) {
      if (currencySelectEl && !currencySelectEl.contains(e.target)) closeCurrencyDropdown();
    });

    ['donationAmount', 'donorEmail', 'firstName', 'lastName', 'phone'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) {
        el.addEventListener('input', clearGlobalError);
        el.addEventListener('change', clearGlobalError);
      }
    });
    if (form) {
      form.querySelectorAll('input[name="Frequency"]').forEach(function (el) {
        el.addEventListener('change', clearGlobalError);
      });
    }

    if (amountInput) {
      amountInput.addEventListener('input', function () {
        clearFieldError('amount_span');
        setInputState(amountInput, false);
        clearGlobalError();
      });
    }
    var emailEl = document.getElementById('donorEmail');
    if (emailEl) {
      emailEl.addEventListener('input', function () {
        clearFieldError('email_span');
        setInputState(emailEl, false);
        clearGlobalError();
      });
      emailEl.addEventListener('blur', function () {
        var val = emailEl.value.trim();
        if (!val) {
          showFieldError('email_span', validationMsgs.emailRequired);
          setInputState(emailEl, true);
        } else if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(val)) {
          showFieldError('email_span', validationMsgs.emailInvalid);
          setInputState(emailEl, true);
        } else {
          clearFieldError('email_span');
          setInputState(emailEl, false);
        }
      });
    }

    if (amountInput) {
      amountInput.addEventListener('keydown', function (e) {
        if (e.key === 'e' || e.key === 'E' || e.key === '+' || e.key === '-') e.preventDefault();
      });
    }
    if (phoneInput) {
      phoneInput.addEventListener('input', function () {
        phoneInput.value = phoneInput.value.replace(/[^\d+\-\s()]/g, '');
        clearFieldError('phone_span');
        setInputState(phoneInput, false);
        clearGlobalError();
      });
      phoneInput.addEventListener('blur', function () {
        var val = phoneInput.value.trim();
        var phonePattern = /^\+?\d{10,16}$/;
        if (val.length > 0 && !phonePattern.test(val)) {
          showFieldError('phone_span', validationMsgs.phoneInvalid);
          setInputState(phoneInput, true);
        } else {
          clearFieldError('phone_span');
          setInputState(phoneInput, false);
        }
      });
    }

    function validateDonateForm() {
      var valid = true;
      var firstInvalidEl = null;

      ['amount_span','email_span','phone_span','s_number','s_expirationDate','s_cvv'].forEach(clearFieldError);
      [amountInput, emailEl, phoneInput].forEach(function(el) { if (el) setInputState(el, false); });

      var rawAmount = amountInput ? amountInput.value.trim() : '';
      var parsedAmount = parseFloat(rawAmount);
      if (!rawAmount) {
        showFieldError('amount_span', validationMsgs.amountRequired);
        setInputState(amountInput, true);
        if (!firstInvalidEl) firstInvalidEl = amountInput;
        valid = false;
      } else if (isNaN(parsedAmount) || parsedAmount < currencyMinAmount) {
        showFieldError('amount_span', validationMsgs.amountMin.replace('{min}', currencyMinAmount));
        setInputState(amountInput, true);
        if (!firstInvalidEl) firstInvalidEl = amountInput;
        valid = false;
      }

      var emailVal = emailEl ? emailEl.value.trim() : '';
      if (!emailVal) {
        showFieldError('email_span', validationMsgs.emailRequired);
        setInputState(emailEl, true);
        if (!firstInvalidEl) firstInvalidEl = emailEl;
        valid = false;
      } else if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(emailVal)) {
        showFieldError('email_span', validationMsgs.emailInvalid);
        setInputState(emailEl, true);
        if (!firstInvalidEl) firstInvalidEl = emailEl;
        valid = false;
      }

      var phoneVal = phoneInput ? phoneInput.value.trim() : '';
      var phonePattern = /^\+?\d{10,16}$/;
      if (phoneVal.length > 0 && !phonePattern.test(phoneVal)) {
        showFieldError('phone_span', validationMsgs.phoneInvalid);
        setInputState(phoneInput, true);
        if (!firstInvalidEl) firstInvalidEl = phoneInput;
        valid = false;
      }

      if (!valid && firstInvalidEl) firstInvalidEl.focus();

      return valid;
    }

    if (!clientToken) {
      if (!hasServerDonationError) {
        showMessage(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["donation_failure_message"].Value)), true);
      }
      if (submitBtn) submitBtn.disabled = true;
      return;
    }

    if (typeof braintree === 'undefined') {
            showMessage(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["donation_failure_message"].Value)), true);
      if (submitBtn) submitBtn.disabled = true;
      return;
    }

    braintree.client.create({ authorization: clientToken }, function (clientErr, clientInstance) {
      if (clientErr) {
              showMessage(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["donation_failure_message"].Value)), true);
        if (submitBtn) submitBtn.disabled = true;
        return;
      }

      braintree.hostedFields.create({
        client: clientInstance,
        styles: {
          'input': donationCulture === 'ar'
            ? { 'font-size': '16px', 'color': '#333', 'text-align': 'right', 'direction': 'ltr' }
            : { 'font-size': '16px', 'color': '#333' },
          'input.invalid': { 'color': '#c00' },
          'input.valid':   { 'color': '#0a7' }
        },
        fields: {
          number:         { selector: '#cardNumber', placeholder: cardNumberPlaceholder },
          expirationDate: { selector: '#cardExpiry', placeholder: 'MM/YY' },
          cvv:            { selector: '#cardCvc',    placeholder: cvvPlaceholder }
        }
      }, function (hfErr, hfInstance) {
        if (hfErr) {
                showMessage(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["donation_failure_message"].Value)), true);
          if (submitBtn) submitBtn.disabled = true;
          return;
        }
        hostedFieldsInstance = hfInstance;

        var hfSpanMap = { 'number': 's_number', 'expirationDate': 's_expirationDate', 'cvv': 's_cvv' };
        hfInstance.on('focus', function (event) {
          var field  = event.emittedBy;
          var spanId = hfSpanMap[field];
          if (spanId) clearFieldError(spanId);
          setInputState(hfContainerMap[field], false);
          clearGlobalError();
        });
        hfInstance.on('change', function () {
          clearGlobalError();
        });
      });
    });

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (isSubmitting) return;

        if (!validateDonateForm()) return;

        if (hostedFieldsInstance) {
          var hfState  = hostedFieldsInstance.getState();
          var hfFields = hfState.fields;
          var hfValid  = true;

          if (hfFields.number && hfFields.number.isEmpty) {
            showFieldError('s_number', validationMsgs.cardNumberRequired);
            setInputState(hfContainerMap['number'], true);
            hfValid = false;
          }
          if (hfFields.expirationDate && hfFields.expirationDate.isEmpty) {
            showFieldError('s_expirationDate', validationMsgs.expiryFieldRequired);
            setInputState(hfContainerMap['expirationDate'], true);
            hfValid = false;
          }
          if (hfFields.cvv && hfFields.cvv.isEmpty) {
            showFieldError('s_cvv', validationMsgs.cvvFieldRequired);
            setInputState(hfContainerMap['cvv'], true);
            hfValid = false;
          }

          if (!hfValid) return;
        }

        var robotError = document.getElementById('robot_span');
        if (document.querySelector('.g-recaptcha')) {
          var recaptchaResponse = typeof grecaptcha !== 'undefined' ? grecaptcha.getResponse() : '';
          if (!recaptchaResponse) {
            if (robotError) {
              robotError.textContent = validationMsgs.recaptchaRequired;
              robotError.classList.add('is-visible');
            }
            return;
          } else if (robotError) {
            robotError.textContent = '';
            robotError.classList.remove('is-visible');
          }
        }

        if (!hostedFieldsInstance) {
                showMessage(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["donation_failure_message"].Value)), true);
          return;
        }

        setSubmitting(true);

        hostedFieldsInstance.tokenize(function (tokenizeErr, payload) {
          if (tokenizeErr) {
            setSubmitting(false);

            var invalidFields = (tokenizeErr.details && tokenizeErr.details.invalidFieldKeys) || [];
            var fieldSpanMap = { 'number': 's_number', 'expirationDate': 's_expirationDate', 'cvv': 's_cvv' };
            var fieldMsgMap  = {
              'number'         : validationMsgs.cardRequired,
              'expirationDate' : validationMsgs.expiryRequired,
              'cvv'            : validationMsgs.cvvRequired
            };

            if (invalidFields.length > 0) {
              invalidFields.forEach(function (key) {
                if (fieldSpanMap[key]) {
                  showFieldError(fieldSpanMap[key], fieldMsgMap[key] || validationMsgs.cardRequired);
                  setInputState(hfContainerMap[key], true);
                }
              });
            } else {
                    showMessage(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizer["donation_failure_message"].Value)), true);
            }
            return;
          }

          if (nonceField && payload && payload.nonce) {
            nonceField.value = payload.nonce;
          }

          form.submit();
        });
      });
    }

    window.hindawiRecaptchaCallback = function () {
      clearGlobalError();
      var robotErr = document.getElementById('robot_span');
      if (robotErr) {
        robotErr.textContent = '';
        robotErr.classList.remove('is-visible');
      }
    };

    (function initCurrencies() {
      var p1 = fetch('/' + donationCulture + '/donate/currencies', { credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : []; })
        .catch(function () { return []; });
      var p2 = fetch('/' + donationCulture + '/donate/default-currency?countryCode=' + encodeURIComponent(cfCountryCode), { credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .catch(function () { return null; });
      Promise.all([p1, p2]).then(function (results) {
        var currencies   = Array.isArray(results[0]) ? results[0] : [];
        var defData      = results[1];
        var defaultCode  = (defData && defData.currencyCode) ? defData.currencyCode : 'USD';
        populateCurrencies(currencies, defaultCode);
      });
    })();
  })();
        </script>
    }
