@using Microsoft.Extensions.Options
@inject IOptions<HindawiFoundation.Web.Models.AppSettings> Options
@{

    ViewData["BodyClass"] = "page page--partners";
    ViewData["ActivePage"] = "partners";

    var partnershipsTeamEmail = Options.Value.PartnershipsTeamEmail;
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/pages/partners.css" asp-append-version="true">
}

<main id="main-content">

    <div class="page-banner">
      <div class="container">
        <h1>Partners</h1>
      </div>
    </div>

    <section class="section section--tight" aria-label="Partners">
      <div class="container">

        <div class="partners-intro">
          <h2 class="partners-intro__title">Empowering Global Literacy, Together</h2>
          <p>We are incredibly grateful to the visionary foundations, corporate sponsors, and organizations that make our mission a reality.</p>
          <p>By funding our translation technology, publishing efforts, and global distribution, our partners are helping us break down language barriers and bring free literature to millions of people worldwide.</p>
          <p>Here is a look at our supporters and the incredible impact of their funding:</p>
        </div>

        <div class="partner-cards-grid" role="list">

          <article class="partner-card" role="listitem">
            <div class="partner-card__logo">
                        <img src="~/Logos/CNL.png?v=4" alt="Gaelic Books Council" class="partner-card__logo-img">
            </div>
            <div class="partner-card__content">
                        <p class="partner-card__value_title">Booktime</p>
              <p class="partner-card__label">The Impact</p>
              <p class="partner-card__value">Translation of books into Gaelic</p>
            </div>
          </article>

          <article class="partner-card" role="listitem">
            <div class="partner-card__logo">
                        <img src="~/Logos/Fundacao_Calouste_Gulbenkian.png?v=4" alt="Fundação Calouste Gulbenkian" class="partner-card__logo-img">
            </div>
            <div class="partner-card__content">
                        <p class="partner-card__value_title">Booktime</p>
              <p class="partner-card__label">The Impact</p>
              <p class="partner-card__value">Translation of books into Western Armenian</p>
            </div>
          </article>

          <article class="partner-card" role="listitem">
            <div class="partner-card__logo">
              <img src="~/Logos/PRODOMINICANA.png?v=4" alt="PRODOMINICANA" class="partner-card__logo-img">
            </div>
            <div class="partner-card__content">
                        <p class="partner-card__value_title">Safahat</p>
              <p class="partner-card__label">The Impact</p>
                        <p class="partner-card__value">Supporting audiobook production</p>
            </div>
          </article>

          <article class="partner-card" role="listitem">
            <div class="partner-card__logo">
                        <img src="~/Logos/Birmingham_City_University.png?v=4" alt="Birmingham City University" class="partner-card__logo-img">
            </div>
            <div class="partner-card__content">
                        <p class="partner-card__value_title">Booktime</p>
              <p class="partner-card__label">The Impact</p>
                        <p class="partner-card__value">Supporting emerging illustrators</p>
            </div>
          </article>

            <article class="partner-card" role="listitem">
                <div class="partner-card__logo">
                    <img src="~/Logos/Ulverscroft.png?v=4" alt="Ulverscroft" class="partner-card__logo-img">
                </div>
                <div class="partner-card__content">
                        <p class="partner-card__value_title">Booktime</p>
                    <p class="partner-card__label">The Impact</p>
                    <p class="partner-card__value">Supporting audiobook production</p>
                </div>
            </article>

        </div>
      </div>
    </section>

    <section class="section section--tight partners-cta" aria-labelledby="partners-cta-title">
      <div class="container">
        <h2 class="partners-cta__title" id="partners-cta-title">Partner with Us to Spread the Joy of Reading</h2>
        <p class="partners-cta__text">Are you an organization, trust, or foundation passionate about global education, cultural preservation, or accessible technology? We are always looking for visionary partners to help us reach new communities and publish more books.</p>
        <p class="partners-cta__text">Whether you want to fund a specific language initiative, sponsor a specific project, or support our core operations, we would love to collaborate.</p>
            <a href="mailto:@partnershipsTeamEmail" class="btn btn--primary btn--icon partners-cta__btn">
          <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          Email Our Partnerships Team
        </a>
      </div>
    </section>

</main>
