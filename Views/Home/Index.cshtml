@{
    ViewData["Title"] = "Home";
    ViewData["BodyClass"] = "page page--home";
    ViewData["ActivePage"] = "home";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/pages/home.css" asp-append-version="true">
}

<main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero__inner">
        <div class="hero__content">
          <h1 id="hero-title">Reading changes everything.</h1>
          <p>We promote the joy of reading by making books free and accessible. We aspire to reach readers across the world in every language.</p>
          <a asp-controller="Home" asp-action="Donate" class="btn btn--primary btn--icon">
            <i class="fa-solid fa-heart" aria-hidden="true"></i>
            Donate
          </a>
        </div>
      </div>
    </section>

    <section class="section section--tight what-we-do" aria-labelledby="what-we-do-title">
      <div class="container">
        <header class="section__header">
          <h2 class="section__title" id="what-we-do-title">What We Do</h2>
          <p class="section__subtitle">Our goal is to instill a lifelong passion for reading in people of all ages worldwide. We provide free access to a world of literature, ensuring that the transformative power of a good book is always within reach.</p>
        </header>

        <div class="products-grid">
          <article class="card card--product">
            <div class="product-icon">
              <img src="~/Logos/Booktime.svg" alt="Booktime logo">
            </div>
            <h3>Booktime</h3>
            <p>Highly illustrated children's books in multiple languages for free.</p>
            <a href="https://www.booktime.org/en" class="product-link product-link--booktime" data-product="booktime" target="_blank" rel="noopener noreferrer">
                booktime.org
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
          </article>

          <article class="card card--product">
            <div class="product-icon">
              <img src="~/Logos/safahat.svg" alt="Safahat logo">
            </div>
            <h3>Safahat</h3>
            <p>A diverse library empowering readers with access to free literature in Arabic.</p>
             <a href="https://www.safahat.org/en/" class="product-link product-link--safahat" data-product="safahat" target="_blank" rel="noopener noreferrer">
                safahat.org
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
             </a>
          </article>

          <article class="card card--product">
            <div class="product-icon">
              <img src="~/Logos/folios.svg" alt="Folios logo">
            </div>
            <h3>Folios</h3>
            <p>An advanced AI translation tool which breaks down language barriers to global literature.</p>
            <a href="https://folios.org/en" class="product-link product-link--folios" data-product="folios" target="_blank" rel="noopener noreferrer">
              folios.org
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
          </article>
        </div>

        <div class="donate-inline">
          <p>Help us spread the joy of reading</p>
          <a asp-controller="Home" asp-action="Donate" class="btn btn--primary btn--icon">
            <i class="fa-solid fa-heart" aria-hidden="true"></i>
            Donate
          </a>
        </div>
      </div>
    </section>

    <hr class="section-divider">

    <section class="section section--tight why-we-do" aria-labelledby="why-we-do-title">
      <div class="container">
        <header class="section__header">
          <h2 class="section__title" id="why-we-do-title">Why We Do It</h2>
        </header>

        <div class="stats-grid">
          <article class="card card--stat">
            <h3 class="stat">1 in 3</h3>
            <p class="desc">children globally lack access to age-appropriate reading materials (UNESCO, 2022)</p>
          </article>

          <article class="card card--stat">
            <h3 class="stat">90%</h3>
            <p class="desc">of books are published in only a handful of dominant languages (UNESCO, 2012)</p>
          </article>

          <article class="card card--stat">
            <h3 class="stat">20%+</h3>
            <p class="desc">reduction in mortality and depression rates in adults who read books (NLT, 2024 and Bavishi, Slade and Levy, 2016)</p>
          </article>

          <article class="card card--stat">
            <h3 class="stat">48%</h3>
            <p class="desc">of children in middle to low income countries do not have a children's book at home (UNICEF, 2021)</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--tight impact" aria-labelledby="impact-title">
      <div class="container">
        <h2 class="section__title" id="impact-title">Impact</h2>
        <div class="impact-grid" role="list">
          <article class="impact-item" role="listitem">
            <div class="impact-icon">
              <i class="fa-solid fa-users" aria-hidden="true"></i>
            </div>
            <p class="number">300K+</p>
            <p class="label">Monthly Readers</p>
          </article>

          <article class="impact-item" role="listitem">
            <div class="impact-icon">
              <img src="~/Icons/book-open-cover.svg" alt="">
            </div>
            <p class="number">10M</p>
            <p class="label label--nowrap">Books Read since 2024</p>
          </article>

          <article class="impact-item" role="listitem">
            <div class="impact-icon">
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            </div>
            <p class="number">190+</p>
            <p class="label">Countries Served</p>
          </article>

          <article class="impact-item" role="listitem">
            <div class="impact-icon">
              <i class="fa-solid fa-globe" aria-hidden="true"></i>
            </div>
            <p class="number">9+</p>
            <p class="label">Languages Served</p>
          </article>

          <article class="impact-item" role="listitem">
            <div class="impact-icon">
              <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i>
            </div>
            <p class="number">3.5K+</p>
            <p class="label">Books Published<br><span>(incl. translations)</span></p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--tight testimonials" aria-labelledby="testimonials-title">
      <div class="container">
        <header class="section__header">
          <h2 class="section__title" id="testimonials-title">Testimonials</h2>
        </header>

        <div class="testimonial-slider" data-slider tabindex="0" aria-label="Testimonials slider">
          <div class="testimonial-track" data-slider-track>
            <article class="card card--testimonial" data-slide>
              <p class="quote">"The quality of the refined translation using Gemini Pro was staggering. It captured the nuances of my protagonist's dialect better than any tool I've used before. It's truly a game-changer for literary work."</p>
              <div class="author-row">
                <p class="author">Michael Samuel</p>
                <img src="~/Icons/quote_mark.svg" alt="" class="quote-mark" aria-hidden="true">
              </div>
            </article>

            <article class="card card--testimonial" data-slide>
              <p class="quote">“Being able to translate my entire back catalog into three different languages in one afternoon for a fraction of traditional costs is a game-changer.”</p>
              <div class="author-row">
                <p class="author">James Henry</p>
                <img src="~/Icons/quote_mark.svg" alt="" class="quote-mark" aria-hidden="true">
              </div>
            </article>
          </div>

          <div class="slider-dots" aria-label="Slider pagination">
            <button class="slider-dot is-active" type="button" data-slide-to="0" aria-label="Show testimonial 1" aria-current="true"></button>
            <button class="slider-dot" type="button" data-slide-to="1" aria-label="Show testimonial 2" aria-current="false"></button>
          </div>
        </div>
      </div>
    </section>

    <section class="section cta" aria-labelledby="cta-title">
      <div class="container cta__inner">
        <div class="cta__content">
          <h2 id="cta-title">Help Us Spread<br>the Joy of Reading</h2>
          <p>Every great story needs a champion. Your support allows us to write and illustrate more books for Booktime, license new material for Safahat, and improve Folios.</p>
        </div>
        <a asp-controller="Home" asp-action="Donate" class="btn btn--light btn--icon">
          <i class="fa-solid fa-heart" aria-hidden="true"></i>
          Donate
        </a>
      </div>
    </section>

    <section class="section section--tight partners" aria-labelledby="partners-title">
      <div class="container">
        <header class="section__header">
          <h2 class="section__title" id="partners-title">Partners</h2>
          <p class="section__subtitle">A special thanks to our partners.</p>
        </header>

        <div class="partners-grid">
          <img src="~/Logos/Fundacao_Calouste_Gulbenkian.svg" alt="Fundação Calouste Gulbenkian" class="partner-logo">
          <img src="~/Logos/Ulverscroft.svg" alt="Ulverscroft" class="partner-logo">
          <img src="~/Logos/CNL.svg" alt="CNL" class="partner-logo">
          <img src="~/Logos/PRODOMINICANA.svg" alt="PRODOMINICANA" class="partner-logo">
          <img src="~/Logos/Birmingham_City_University.svg" alt="Birmingham City University" class="partner-logo">
        </div>
      </div>
    </section>
</main>
