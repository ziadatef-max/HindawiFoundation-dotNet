@{
    ViewData["BodyClass"] = "page page--contact";
    ViewData["ActivePage"] = "contact";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/pages/contact.css" asp-append-version="true">
}

<main id="main-content">

    <div class="page-banner">
      <div class="container">
            <h1>تواصل معنا</h1>
      </div>
    </div>

    <section class="section section--tight" aria-labelledby="contact-info-title">
      <div class="container">

        <div class="contact-layout">

          <div class="contact-block">
            <h2 class="contact-block__title" id="contact-info-title">تواصل معنا</h2>
            <p class="contact-block__desc">يسعدنا دائمًا أن نتواصل معكم؛ سواء للاستفسار عن خدماتنا، أو للتنسيق الإعلامي والصحفي، أو لتقديم مقترحات للتعاون المشترك. يُرجى ملء النموذج أدناه، وسيقوم فريقنا بالرد عليكم في أقرب وقت.</p>

            <ul class="contact-list" aria-label="تفاصيل التواصل">
              <li class="contact-list-item">
                <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                <p><a href="mailto:hindawi@@hindawi.org">hindawi@@hindawi.org</a></p>
              </li>
              <li class="contact-list-item">
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                <p>
                  مؤسسة هنداوي<br>
                  York House<br>
                  41 Sheet Street<br>
                  وندسور، بيركشاير<br>
                  SL4 1DD<br>
                  المملكة المتحدة
                </p>
              </li>
            </ul>
          </div>

          <div class="contact-map" aria-label="خريطة تُظهر موقع مكتب وندسور بالمملكة المتحدة">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2484.867443767909!2d-0.6061105999999998!3d51.478947399999996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x48767afb9ddbd061%3A0xddd0f9528819e3a0!2sWindsor%20%26%20Maidenhead%20Council!5e0!3m2!1sen!2seg!4v1777882928282!5m2!1sen!2seg" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>

        </div>

        <div class="contact-hubs" aria-labelledby="hubs-title">
          <h2 class="contact-hubs__title" id="hubs-title">مقران رئيسيان … ورسالة عالمية واحدة</h2>
          <p class="contact-hubs__desc">رغم أننا نباشر أعمالنا الرئيسية من المملكة المتحدة ومصر، فإن رسالتنا تستمد قوتها من شبكة عالمية استثنائية عابرة للحدود، تضم نخبة من المبدعين المستقلين، والمترجمين، وخبراء جمع التبرعات ممن يشاركوننا الشغف نفسه في جميع أنحاء العالم.</p>

          <ul class="hubs-list" aria-label="مواقع المكاتب">
            <li class="hub-item">
              <p class="hub-item__country">المملكة المتحدة</p>
              <p class="hub-item__city">وندسور</p>
            </li>
            <li class="hub-item">
              <p class="hub-item__country">مصر</p>
              <p class="hub-item__city">القاهرة</p>
            </li>
          </ul>
        </div>

        <div class="contact-community" aria-labelledby="community-title">
          <h2 class="contact-community__title" id="community-title">انضم إلى مجتمعنا العالمي</h2>
          <p class="contact-community__desc">تابع حساباتنا على مواقع التواصل الاجتماعي للاطلاع على أحدث أخبار «مؤسسة هنداوي».</p>

          <ul class="contact-social" aria-label="روابط التواصل الاجتماعي">
            <li>
                        <a href="https://www.linkedin.com/company/hindawi-foundation" class="contact-social__link linkedin" aria-label="تابعنا على LinkedIn" target="_blank" rel="noopener noreferrer">
                <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
              </a>
            </li>
            <li>
                        <a href="https://www.facebook.com/hindawi.org" class="contact-social__link facebook" aria-label="تابعنا على Facebook" target="_blank" rel="noopener noreferrer">
                <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
              </a>
            </li>
            <li>
                        <a href="https://www.instagram.com/hindawiorg" class="contact-social__link instagram" aria-label="تابعنا على Instagram" target="_blank" rel="noopener noreferrer">
                <i class="fa-brands fa-instagram" aria-hidden="true"></i>
              </a>
            </li>
          </ul>
        </div>

      </div>
    </section>

</main>
