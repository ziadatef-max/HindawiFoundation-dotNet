@{
    ViewData["Title"] = "Manage Donations";
    ViewData["BodyClass"] = "page page--donate";
    ViewData["ActivePage"] = "donate";
    var culture = ViewData["Culture"]?.ToString() ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "en";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/pages/donate.css" asp-append-version="true">
}

<main id="main-content">

    <div class="page-banner">
      <div class="container">
        <h1>Manage Your Donation</h1>
      </div>
    </div>

    <section class="section section--tight">
      <div class="container">
        <div class="donate-intro">
          <h2 class="donate-intro__title">Cancel or modify a recurring donation</h2>
          <p class="donate-intro__desc">To unsubscribe from a recurring donation, please contact us at <a href="mailto:donations@hindawi.org">donations@hindawi.org</a> with your details and we will assist you.</p>
          <p class="donate-intro__desc">
            <a asp-controller="Home" asp-action="Index" asp-route-culture="@culture">Return to home</a>
          </p>
        </div>
      </div>
    </section>

</main>
