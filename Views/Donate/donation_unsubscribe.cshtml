@{
    ViewData["TitleKey"] = "donate_unsubscribe_page_title";
    ViewData["BodyClass"] = "page page--donate";
    ViewData["ActivePage"] = "donate";
    var culture = ViewData["Culture"]?.ToString() ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "en";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/pages/donate.css" asp-append-version="true">
}

<main id="main-content">

    <div class="page-banner">
      <div class="container">
        <h1>@localizer["donate_unsubscribe_page_title"]</h1>
      </div>
    </div>

    <section class="section section--tight">
      <div class="container">
        <div class="donate-intro">
          <h2 class="donate-intro__title">@localizer["donate_unsubscribe_title"]</h2>
          <p class="donate-intro__desc">@localizer["donate_unsubscribe_desc"]</p>
          <p class="donate-intro__desc">
            <a asp-controller="Home" asp-action="Index" asp-route-culture="@culture">@localizer["button_back_home"]</a>
          </p>
        </div>
      </div>
    </section>

</main>
