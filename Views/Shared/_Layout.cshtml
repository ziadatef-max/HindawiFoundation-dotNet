@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "en";
    if (culture != "ar") culture = "en";
    var dir = culture == "ar" ? "rtl" : "ltr";
    var layoutClass = culture == "ar" ? "layout-rtl" : "layout-ltr";
    var bodyClass = ViewData["BodyClass"] as string ?? "page";
    var pageTitleKey = ViewData["TitleKey"] as string;
    var pageTitle = !string.IsNullOrEmpty(pageTitleKey)
        ? localizer[pageTitleKey].Value
        : (ViewData["Title"] as string ?? string.Empty);
    var siteName = localizer["website_name_label"].Value;
    var fullTitle = string.IsNullOrEmpty(pageTitle) || pageTitle == localizer["home_button"].Value
        ? $"{siteName}"
        : $"{pageTitle} - {siteName}";

    var bnActive = ViewData["ActivePage"] as string ?? string.Empty;
    string BnIsActive(string key) => bnActive == key ? "is-active" : string.Empty;
}
<!DOCTYPE html>
<html lang="@culture" dir="@dir">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@fullTitle</title>
  <link rel="icon" href="~/Images/Favicon.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@@700&family=Source+Sans+3:wght@@300;400;500;600;700&family=Playfair+Display:wght@@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
  <link rel="stylesheet" href="~/assets/css/tokens.css" asp-append-version="true">
  <link rel="stylesheet" href="~/assets/css/base.css" asp-append-version="true">
  <link rel="stylesheet" href="~/assets/css/layout.css" asp-append-version="true">
  <link rel="stylesheet" href="~/assets/css/utilities.css" asp-append-version="true">
  <link rel="stylesheet" href="~/assets/css/components.css" asp-append-version="true">
  @if (culture == "ar")
  {
      <link rel="stylesheet" href="~/assets/css/rtl.css" asp-append-version="true">
  }
  @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@layoutClass @bodyClass" data-culture="@culture">
<div class="website-wrapper">
      @await Html.PartialAsync("_Header")

      @RenderBody()

      @await Html.PartialAsync("_Footer")

      <nav class="mobile-bottom-nav" aria-label="Mobile bottom navigation">
        <a asp-controller="Home" asp-action="Index" asp-route-culture="@culture" class="mobile-bottom-nav__item @BnIsActive("home")">
          <i class="fa-solid fa-house mobile-bottom-nav__icon" aria-hidden="true"></i>
          <span class="mobile-bottom-nav__label">@localizer["home_button"]</span>
        </a>
        <a asp-controller="Home" asp-action="About" asp-route-culture="@culture" class="mobile-bottom-nav__item @BnIsActive("about")">
          <i class="fa-solid fa-circle-info mobile-bottom-nav__icon" aria-hidden="true"></i>
          <span class="mobile-bottom-nav__label">@localizer["about_us_button"]</span>
        </a>
        <a asp-controller="Home" asp-action="News" asp-route-culture="@culture" class="mobile-bottom-nav__item @BnIsActive("news")">
          <i class="fa-solid fa-newspaper mobile-bottom-nav__icon" aria-hidden="true"></i>
          <span class="mobile-bottom-nav__label">@localizer["news_button"]</span>
        </a>
        <a asp-controller="Home" asp-action="Partners" asp-route-culture="@culture" class="mobile-bottom-nav__item @BnIsActive("partners")">
          <i class="fa-solid fa-handshake mobile-bottom-nav__icon" aria-hidden="true"></i>
          <span class="mobile-bottom-nav__label">@localizer["partners_button"]</span>
        </a>
        <a asp-controller="Home" asp-action="Contact" asp-route-culture="@culture" class="mobile-bottom-nav__item @BnIsActive("contact")">
          <i class="fa-solid fa-envelope mobile-bottom-nav__icon" aria-hidden="true"></i>
          <span class="mobile-bottom-nav__label">@localizer["contact_us_button"]</span>
        </a>
        <a asp-controller="Donate" asp-action="Index" asp-route-culture="@culture" class="mobile-bottom-nav__item @BnIsActive("donate")">
          <i class="fa-solid fa-heart mobile-bottom-nav__icon" aria-hidden="true"></i>
          <span class="mobile-bottom-nav__label">@localizer["donate_button"]</span>
        </a>
      </nav>
  </div>
  <script type="module" src="~/assets/js/main.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
