@using HindawiFoundation.Web.Services.Static
@{
    var active = ViewData["ActivePage"] as string ?? string.Empty;
    var routeCulture = ViewContext.RouteData.Values["culture"]?.ToString()?.ToLowerInvariant();
    var culture = string.Equals(routeCulture, "ar", StringComparison.OrdinalIgnoreCase) ? "ar" : "en";
    string IsActive(string key) => active == key ? "is-active" : string.Empty;

    var routeAction     = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var routeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var routeId         = ViewContext.RouteData.Values["id"]?.ToString();

    string SegmentForRoute()
    {
        if (string.Equals(routeController, "Donate", StringComparison.OrdinalIgnoreCase))
            return "donate";
        if (string.Equals(routeAction, "NewsDetails", StringComparison.OrdinalIgnoreCase))
            return "news";
        if (string.Equals(routeAction, "Index", StringComparison.OrdinalIgnoreCase))
            return string.Empty;
        return routeAction.ToLowerInvariant();
    }

    var segment  = SegmentForRoute();
    var idSuffix = string.IsNullOrEmpty(routeId) ? string.Empty : "/" + routeId;
    var qs = Context.Request.QueryString.Value ?? string.Empty;

    string MakeUrl(string cult)
    {
        var path = $"/{cult}";
        if (!string.IsNullOrEmpty(segment)) path += $"/{segment}";
        path += idSuffix;
        return path + qs;
    }

    var englishUrl = MakeUrl("en");
    var arabicUrl  = MakeUrl("ar");

    var logoSrc = culture == "ar" ? "/Logos/hindawi_ar.svg?v=3" : "/Logos/hindawi_en.svg?v=3";
    var logoAlt = localizer["website_name_label"].Value;
}
<header class="site-header" data-component="header">
    <div class="site-header__top">
      <div class="container">
        <a asp-controller="Home" asp-action="Index" asp-route-culture="@culture" class="site-logo" aria-label="@logoAlt">
          <img class="site-logo__img" src="@logoSrc" alt="@logoAlt">
        </a>

        <ul class="site-header__utilities" aria-label="Header utilities">
          <li class="utility-item language-switch">
            <button
              class="utility-btn"
              type="button"
              aria-label="Change language"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="languageMenu"
              data-language-toggle
            >
              <i class="fa-solid fa-globe" aria-hidden="true"></i>
            </button>
            <ul class="language-menu" id="languageMenu" aria-label="Language options">
              @foreach (var lang in SupportedLanguages.All)
              {
                var langUrl = lang.IsoCode == "ar" ? arabicUrl : englishUrl;
                <li><a href="@langUrl" class="@(culture == lang.IsoCode ? "is-active" : "")" data-lang="@lang.IsoCode" aria-current="@(culture == lang.IsoCode ? "true" : "false")">@lang.Name</a></li>
              }
            </ul>
          </li>
        </ul>
        <button
          class="mobile-toggle"
          type="button"
          data-mobile-toggle
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobileMenu"
        >
          <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>
      </div>
    </div>

    <div class="site-header__bottom">
      <div class="container">
        <nav class="site-nav" aria-label="Primary">
          <ul class="site-nav__menu">
            <li><a asp-controller="Home" asp-action="Index"    asp-route-culture="@culture" class="@IsActive("home")">@localizer["home_button"]</a></li>
            <li><a asp-controller="Home" asp-action="About"    asp-route-culture="@culture" class="@IsActive("about")">@localizer["about_us_button"]</a></li>
            <li><a asp-controller="Home" asp-action="News"     asp-route-culture="@culture" class="@IsActive("news")">@localizer["news_button"]</a></li>
            <li><a asp-controller="Home" asp-action="Partners" asp-route-culture="@culture" class="@IsActive("partners")">@localizer["partners_button"]</a></li>
            <li><a asp-controller="Home" asp-action="Contact"  asp-route-culture="@culture" class="@IsActive("contact")">@localizer["contact_us_button"]</a></li>
          </ul>
          <ul class="site-nav__donate">
            <li>
              <a asp-controller="Donate" asp-action="Index" asp-route-culture="@culture" class="@IsActive("donate")">
                <i class="fa-solid fa-heart" aria-hidden="true"></i>
                @localizer["donate_button"]
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
</header>

<nav class="mobile-nav" id="mobileMenu" aria-label="Mobile" hidden>
    <button class="mobile-nav__close" type="button" data-mobile-close aria-label="Close menu">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
    <a asp-controller="Home" asp-action="Index"    asp-route-culture="@culture" class="@IsActive("home")">@localizer["home_button"]</a>
    <a asp-controller="Home" asp-action="About"    asp-route-culture="@culture" class="@IsActive("about")">@localizer["about_us_button"]</a>
    <a asp-controller="Home" asp-action="News"     asp-route-culture="@culture" class="@IsActive("news")">@localizer["news_button"]</a>
    <a asp-controller="Home" asp-action="Partners" asp-route-culture="@culture" class="@IsActive("partners")">@localizer["partners_button"]</a>
    <a asp-controller="Home" asp-action="Contact"  asp-route-culture="@culture" class="@IsActive("contact")">@localizer["contact_us_button"]</a>
    <a asp-controller="Donate" asp-action="Index"  asp-route-culture="@culture" class="@IsActive("donate")">@localizer["donate_button"]</a>
</nav>
